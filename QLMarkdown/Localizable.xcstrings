  "strings" : {
    "(%@)\n\nYou can manually install the tool from a Terminal shell with this command: \nln -sfv \"%@\" \"%@\"" : {
      "comment" : "A localized error message.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "(%1$@)\n\nYou can manually install the tool from a Terminal shell with this command: \nln -sfv \"%2$@\" \"%3$@\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)\n\nPuedes instalar la herramienta manualmente desde Terminal con este comando: \nln -sfv \"%@\" \"%@\""
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%1$@)\n\nPuoi installare manualmente il tool dal Terminale con questo comando: \nln -sfv \"%2$@\" \"%3$@\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%1$@)\n\n你可以用下面的命令在终端中手动安装该工具：\nln -sfv \"%2$@\" \"%3$@\""
          }
        }
